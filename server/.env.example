# Copy to .env for local development. None of these are required for `npm test`.

NODE_ENV=development
PORT=4000

MONGO_URI=mongodb://127.0.0.1:27017/pulseboard
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

STRIPE_TOLERANCE_SECONDS=300

CORS_ORIGIN=http://localhost:5173

# Optional: real SMTP transport for alert emails. If unset, emails are
# formatted and "sent" via nodemailer's jsonTransport (logged, not delivered).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
