{
  "name": "pulseboard-ops-server",
  "version": "1.0.0",
  "description": "Real-time event ingestion, rule engine, and alerting backend for pulseboard-ops",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --config jest.config.js --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --config jest.config.js --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --config jest.config.js --coverage --runInBand",
    "test:integration": "cross-env NODE_ENV=test RUN_INTEGRATION=1 jest --config jest.integration.config.js --runInBand",
    "lint": "eslint src"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.3",
    "nodemailer": "^6.9.15",
    "socket.io": "^4.8.0",
    "uuid": "^9.0.1",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "nock": "^13.5.5",
    "socket.io-client": "^4.8.0",
    "supertest": "^7.0.0"
  },
  "license": "MIT"
}
